# Reverse proxy in front of the collector (docs/OPERATING.md). Caddy terminates TLS
# (automatic certificates) and forwards to the loopback listener. The collector bounds its
# own bodies, connections and rates (in-flight caps and a token bucket per ingest key);
# this proxy adds TLS and a body cap. It sets no per-client rate limit (Caddy has none
# built in): add one at your edge if clients other than your hosts can reach it.
aiops.example.com {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	reverse_proxy 127.0.0.1:57400 {
		header_up X-Request-Id {http.request.uuid}
		transport http {
			dial_timeout 2s
			response_header_timeout 15s
		}
	}
	# Hosts post to /v1/ingest; people use /console/; nothing else is served.
	redir /console /console/ 308
	@other not path /console /v1/* /console/* /healthz /readyz
	respond @other 404
}
