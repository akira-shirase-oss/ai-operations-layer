# /etc/aiops/aiops-server.env — the collector's production configuration (docs/OPERATING.md).
# Owned by root, mode 0640, group aiops: it holds the database password and the runner's
# read key. Every variable is read once at startup; unknown values are refused with all
# errors listed together.

# Required. A dedicated role that owns the aiops database (migrations run on every start).
AIOPS_DATABASE_URL=postgres://aiops:CHANGE-ME@127.0.0.1:5432/aiops
# Loopback only: the reverse proxy terminates TLS in front of it (deploy/Caddyfile.example).
AIOPS_LISTEN=127.0.0.1:57400
# The built console (npm run build --workspace @aiops/console), served at /console/.
AIOPS_CONSOLE_DIR=/opt/aiops/console
AIOPS_LOG=info,tower_http=warn,sqlx=warn

# Optional: Durable Runner's own answer beside its operations (D-027). Its read-only key,
# never its API key.
#AIOPS_AUTHORITY_DURABLE_RUNNER=dr-prod=http://127.0.0.1:58300
#AIOPS_AUTHORITY_DURABLE_RUNNER_READ_KEY=

# Bounds (defaults shown; change them only with a measurement, D-022).
#AIOPS_INGEST_MAX_IN_FLIGHT=64
#AIOPS_INGEST_BODY_BUDGET_MIB=32
#AIOPS_INGEST_EVENTS_PER_SEC=20000
#AIOPS_INGEST_BURST_EVENTS=100000
#AIOPS_INGEST_CONNECTIONS=16
#AIOPS_QUERY_REQUESTS_PER_SEC=20
#AIOPS_QUERY_BURST=60
#AIOPS_MAX_CONNECTIONS=2048
#AIOPS_RETENTION_SWEEP_SECS=300
